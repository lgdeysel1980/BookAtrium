{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.docx",
  "name": "DOCX Metadata Reader",
  "description": "Reads DOCX core/app/custom properties, authors, keywords, page counts, identifiers, Calibre-style custom metadata, and the first plausible embedded cover image.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.DocxMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.DocxMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "docx" ]
}
