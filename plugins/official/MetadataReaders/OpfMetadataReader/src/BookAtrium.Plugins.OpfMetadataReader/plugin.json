{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.opf",
  "name": "OPF Metadata Reader",
  "description": "Reads standalone OPF package metadata, identifiers, authors, series, subjects, page data, and linked cover images.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.OpfMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.OpfMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "opf" ]
}
