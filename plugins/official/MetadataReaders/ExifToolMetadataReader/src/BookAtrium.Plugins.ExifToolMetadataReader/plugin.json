{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.exiftool",
  "name": "ExifTool Metadata Reader",
  "description": "Optional external metadata probe. Uses ExifTool when it is installed or bundled with the app, filling metadata gaps without replacing native readers.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.ExifToolMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.ExifToolMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [
    "azw", "azw1", "azw3", "cbz", "docx", "epub", "fb2", "html", "htm", "kepub",
    "lit", "lrf", "lrx", "mobi", "odt", "opf", "pdf", "pobi", "prc", "rar", "rtf",
    "tpz", "xhtml", "zip"
  ]
}
