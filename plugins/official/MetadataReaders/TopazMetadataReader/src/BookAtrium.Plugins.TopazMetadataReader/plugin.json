{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.topaz",
  "name": "Topaz Metadata Reader",
  "description": "Parses the embedded metadata block from Amazon Topaz (TPZ/AZW1) files, with a best-effort binary scan fallback.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.TopazMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.TopazMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "tpz", "azw1" ]
}
