{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.odt",
  "name": "ODT Metadata Reader",
  "description": "Reads OpenDocument text metadata, authors, keywords, statistics, identifiers, Calibre-style user-defined metadata, and embedded cover images.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.OdtMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.OdtMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "odt" ]
}
