{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.conversioninput.kindle",
  "name": "Kindle Conversion Input",
  "description": "Reads Kindle MOBI/AZW/AZW3/PRC/POBI books (clean-room Palm/MOBI parsing; DRM-protected files are rejected) into the BookAtrium conversion intermediate representation.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "ConversionInput",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.KindleConversionInput.dll",
  "entryType": "BookAtrium.Plugins.KindleConversionInput.Plugin",
  "capabilities": [ "ReadInputFormat", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "mobi", "azw", "azw3", "prc", "pobi" ]
}
