{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.conversioninput.html",
  "name": "HTML Conversion Input",
  "description": "Reads HTML/XHTML documents, sanitizing markup and importing local images, into the BookAtrium conversion intermediate representation.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "ConversionInput",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.HtmlConversionInput.dll",
  "entryType": "BookAtrium.Plugins.HtmlConversionInput.Plugin",
  "capabilities": [ "ReadInputFormat", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "html", "htm", "xhtml" ]
}
