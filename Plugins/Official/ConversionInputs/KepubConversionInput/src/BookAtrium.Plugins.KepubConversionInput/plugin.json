{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.conversioninput.kepub",
  "name": "KEPUB Conversion Input",
  "description": "Reads Kobo KEPUB packages (EPUB structure with Kobo reader markup stripped) into the BookAtrium conversion intermediate representation.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "ConversionInput",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.KepubConversionInput.dll",
  "entryType": "BookAtrium.Plugins.KepubConversionInput.Plugin",
  "capabilities": [ "ReadInputFormat", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "kepub" ]
}
