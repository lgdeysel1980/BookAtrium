{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.rtf",
  "name": "RTF Metadata Reader",
  "description": "Reads RTF info-block metadata, authors, subject/comments, keywords/categories, publisher fields, dates, identifiers, and estimated page counts.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.RtfMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.RtfMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "rtf" ]
}
