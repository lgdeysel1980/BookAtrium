{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.rar",
  "name": "RAR Metadata Reader",
  "description": "Reads RAR and CBR archive metadata, image counts, and stored ComicInfo.xml metadata when the XML entry is not compressed.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.RarMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.RarMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "rar", "cbr" ]
}
