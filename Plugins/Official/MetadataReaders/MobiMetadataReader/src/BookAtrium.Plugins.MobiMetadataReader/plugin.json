{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatareader.mobi",
  "name": "MOBI Metadata Reader",
  "description": "Reads MOBI, AZW, AZW3, PRC and POBI Palm database headers, MOBI title fields, EXTH authors/publisher/description/subjects/identifiers/language, and embedded cover records when present.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataReader",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.MobiMetadataReader.dll",
  "entryType": "BookAtrium.Plugins.MobiMetadataReader.Plugin",
  "capabilities": [ "ReadBookMetadata" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "mobi", "azw", "azw3", "prc", "pobi" ]
}
