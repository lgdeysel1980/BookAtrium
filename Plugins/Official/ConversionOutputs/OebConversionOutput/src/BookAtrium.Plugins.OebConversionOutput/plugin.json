  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "ConversionOutput",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.OebConversionOutput.dll",
  "entryType": "BookAtrium.Plugins.OebConversionOutput.Plugin",
  "capabilities": [ "ProduceOutputFormat", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "oeb" ]
}
