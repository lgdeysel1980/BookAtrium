  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.KepubConversionOutput.dll",
  "entryType": "BookAtrium.Plugins.KepubConversionOutput.Plugin",
