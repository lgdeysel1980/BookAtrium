  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "ConversionOutput",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
