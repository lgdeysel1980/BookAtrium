{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatawriter.lrf",
  "name": "LRF Metadata Writer",
  "description": "Attempts safe LRF metadata writing through ExifTool when available. Protected or unsupported files are left unchanged.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataWriter",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.LrfMetadataWriter.dll",
  "entryType": "BookAtrium.Plugins.LrfMetadataWriter.Plugin",
  "capabilities": [ "WriteBookMetadata", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "lrf" ]
}
