{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatawriter.epub",
  "name": "EPUB Metadata Writer",
  "description": "Updates EPUB/KePub/OPF package metadata using the same OPF update logic as BookAtrium's Book Editor and metadata embedding pipeline.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataWriter",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "supportedPlatforms": [ "windows" ],
  "entryAssembly": "BookAtrium.Plugins.EpubMetadataWriter.dll",
  "entryType": "BookAtrium.Plugins.EpubMetadataWriter.Plugin",
  "capabilities": [ "WriteBookMetadata", "TemporaryFileAccess" ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "contentTypes": [ "epub", "kepub", "opf" ]
}
