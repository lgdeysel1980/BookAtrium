{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatasource.goodreads",
  "name": "Goodreads",
  "description": "Searches Goodreads for book metadata and combines Goodreads genres with popular shelf tags.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.GoodreadsMetadataSource.dll",
  "entryType": "BookAtrium.Plugins.GoodreadsMetadataSource.Plugin",
  "capabilities": [
    "SearchByTitleAuthor",
    "SearchByIsbn",
    "SearchByExternalIdentifier",
    "CoverSearch",
    "Description",
    "Identifiers",
    "SeriesMetadata",
    "Ratings",
    "Publisher",
    "PublicationDate",
    "TagsSubjects",
    "NetworkAccess",
    "MetadataLookup",
    "CoverDownload"
  ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "networkHosts": [ "www.goodreads.com" ]
}
