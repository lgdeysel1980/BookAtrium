{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatasource.google-images",
  "name": "Google Images",
  "description": "Finds alternate cover image candidates from Google Images. This source is cover-focused and intentionally returns minimal book metadata.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.GoogleImagesMetadataSource.dll",
  "entryType": "BookAtrium.Plugins.GoogleImagesMetadataSource.Plugin",
  "capabilities": [
    "CoverSearch",
    "NetworkAccess",
    "MetadataLookup",
    "CoverDownload"
  ],
  "requiresRestart": false,
  "defaultEnabled": false,
  "networkHosts": [ "www.google.com" ]
}
