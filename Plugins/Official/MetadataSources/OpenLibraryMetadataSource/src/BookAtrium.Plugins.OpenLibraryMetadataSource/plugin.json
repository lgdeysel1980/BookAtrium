{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatasource.openlibrary",
  "name": "Open Library",
  "description": "Searches Open Library for public catalogue metadata and cover images.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.OpenLibraryMetadataSource.dll",
  "entryType": "BookAtrium.Plugins.OpenLibraryMetadataSource.Plugin",
  "capabilities": [
    "SearchByTitleAuthor",
    "SearchByIsbn",
    "SearchByExternalIdentifier",
    "CoverSearch",
    "Description",
    "Identifiers",
    "Publisher",
    "PublicationDate",
    "TagsSubjects",
    "NetworkAccess",
    "MetadataLookup",
    "CoverDownload"
  ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "networkHosts": [ "openlibrary.org" ]
}
