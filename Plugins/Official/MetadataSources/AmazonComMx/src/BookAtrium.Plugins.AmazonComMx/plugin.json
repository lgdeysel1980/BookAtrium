{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatasource.amazon-com-mx",
  "name": "Amazon.com.mx, Mexico",
  "description": "Searches Amazon.com.mx, Mexico book detail pages for title, author, identifiers, cover, series, ratings, publisher, date, language, and tags.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.AmazonComMx.dll",
  "entryType": "BookAtrium.Plugins.AmazonComMx.Plugin",
  "capabilities": [
    "SearchByTitleAuthor",
    "SearchByIsbn",
    "SearchByExternalIdentifier",
    "CoverSearch",
    "Description",
    "Identifiers",
    "SeriesMetadata",
    "Ratings",
    "Publisher",
    "PublicationDate",
    "TagsSubjects",
    "NetworkAccess",
    "MetadataLookup",
    "CoverDownload"
  ],
  "requiresRestart": false,
  "defaultEnabled": false,
  "networkHosts": [ "www.amazon.com.mx" ]
}
