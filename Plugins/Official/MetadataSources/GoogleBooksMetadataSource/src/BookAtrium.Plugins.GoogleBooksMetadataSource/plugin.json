{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.metadatasource.google",
  "name": "Google",
  "description": "Searches Google Books for book metadata, ISBNs, ratings, descriptions and covers.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "MetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.GoogleBooksMetadataSource.dll",
  "entryType": "BookAtrium.Plugins.GoogleBooksMetadataSource.Plugin",
  "capabilities": [
    "SearchByTitleAuthor",
    "SearchByIsbn",
    "SearchByExternalIdentifier",
    "CoverSearch",
    "Description",
    "Identifiers",
    "Ratings",
    "Publisher",
    "PublicationDate",
    "TagsSubjects",
    "NetworkAccess",
    "MetadataLookup",
    "CoverDownload"
  ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "networkHosts": [ "www.googleapis.com", "books.google.com" ]
}
