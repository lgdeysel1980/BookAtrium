{
  "manifestVersion": 1,
  "id": "com.practicore.bookatrium.authormetadatasource.goodreads",
  "name": "Goodreads",
  "description": "Searches Goodreads author profiles for biography, dates, website, portrait, and Goodreads ID.",
  "version": "1.0.0",
  "publisher": "PractiCore",
  "author": "PractiCore",
  "license": "MIT",
  "pluginType": "AuthorMetadataSource",
  "pluginApiVersion": "2.0",
  "minimumAppVersion": "1.0.0",
  "targetFramework": "net10.0",
  "entryAssembly": "BookAtrium.Plugins.GoodreadsAuthorMetadataSource.dll",
  "entryType": "BookAtrium.Plugins.GoodreadsAuthorMetadataSource.Plugin",
  "capabilities": [
    "MetadataLookup",
    "CoverDownload",
    "NetworkAccess"
  ],
  "requiresRestart": false,
  "defaultEnabled": true,
  "networkHosts": [ "www.goodreads.com" ]
}
