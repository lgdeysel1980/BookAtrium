<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BookAtrium.PluginCli</RootNamespace>
    <AssemblyName>bookatrium-plugin</AssemblyName>
    <Version>2.1.0</Version>
    <Description>BookAtrium Plugin API 2.1 CLI — new, test, validate, pack.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookAtrium.PluginContracts\BookAtrium.PluginContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\samples\templates\sdk2\**\Plugin.cs">
      <Link>templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
